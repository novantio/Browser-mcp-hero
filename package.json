{
  "name": "hero-browser",
  "version": "0.1.0",
  "private": true,
  "description": "A browser foundation for a shared human and AI session.",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "node scripts/start.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "node scripts/build.cjs && node --test tests/*.test.cjs",
    "test:e2e": "node scripts/build.cjs && node tests/electron.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "44.2.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
